# Local PostgreSQL database. Create this database before running the app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dark_grey_market

# Used only by the browser test. Its database name must end in _test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dark_grey_market_test

# Better Auth. Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
