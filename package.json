{
  "name": "dark-grey-market",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:migrate:stock-images": "node --env-file-if-exists=.env.local scripts/migrate-stock-images-to-blob.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:test:reset": "node --env-file-if-exists=.env.local scripts/reset-test-database.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright install chromium && playwright test",
    "test:all": "npm run lint && npm test && npm run test:smoke"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.5",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
